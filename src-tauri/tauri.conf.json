{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Video Toolset",
  "version": "0.1.0",
  "identifier": "com.video-toolset.app",
  "build": {
    "beforeDevCommand": "cd .. && vite",
    "beforeBuildCommand": "cd .. && vite build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Video Scene Detection Tool",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "maximized": false,
        "center": true,
        "decorations": true,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Your Name",
    "icon": [
      "icons/icon.svg"
    ],
    "resources": [],
    "externalBin": [],
    "copyright": "",
    "category": "DeveloperTool",
    "shortDescription": "",
    "longDescription": ""
  },
  "plugins": {}
}
